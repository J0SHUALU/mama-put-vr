  m_Script: {fileID: 11500000, guid: 4ed959ef06e824a1ead1b0386efd4e01, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamaPut.Tutorial
  body: {fileID: 1513692079}
  hintLabel: {fileID: 1706404210}
  counter: {fileID: 646103226}
  pointerRing: {fileID: 260727125}
  voiceSource: {fileID: 2011607685}
  steps:
  - text: Pick up the ladle and scoop from the rice pot.
    hint: Ladle is in front of you
    pointAt: {fileID: 1076977846}
    voice: {fileID: 0}
  - text: Tip it over a clean plate, then hold the plate out to the customer and
      let go.
    hint: Plates are on your left
    pointAt: {fileID: 1631321488}
    voice: {fileID: 0}
  - text: Take their note, drop it in the cash tin, and hand back any change from
      the tray.
    hint: Cash tin is on your left
    pointAt: {fileID: 1486637717}
    voice: {fileID: 0}
  - text: That's it. Count your change twice and don't give credit to the bus drivers.
    hint: 
    pointAt: {fileID: 0}
    voice: {fileID: 0}
