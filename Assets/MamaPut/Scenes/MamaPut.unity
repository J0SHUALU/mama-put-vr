  m_Script: {fileID: 11500000, guid: 4ed959ef06e824a1ead1b0386efd4e01, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MamaPut.Tutorial
  body: {fileID: 2009262288}
  hintLabel: {fileID: 1071919568}
  counter: {fileID: 1860594298}
  pointerRing: {fileID: 765094683}
  pointerLabel: {fileID: 1546966208}
  voiceSource: {fileID: 233203494}
  steps:
  - text: Pick up the ladle and scoop from the rice pot.
    hint: Ladle is in front of you
    pointAt: {fileID: 545696406}
    pointLabel: Grab this
    voice: {fileID: 0}
  - text: Tip it over a clean plate. Holding the plate, press A to hand it over.
    hint: Plates are on your left
    pointAt: {fileID: 1184885472}
    pointLabel: Scoop here
    voice: {fileID: 0}
  - text: Press A to take their money. Owe change? Grab notes from the tray and press
      A.
    hint: Cash table is on your right
    pointAt: {fileID: 872624355}
    pointLabel: Cash goes here
    voice: {fileID: 0}
  - text: That's it. Count your change twice and don't give credit to the bus drivers.
    hint: 
    pointAt: {fileID: 0}
    pointLabel: 
    voice: {fileID: 0}
